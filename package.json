{
  "name": "identity-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/admin",
    "packages/contracts",
    "packages/sdk-typescript",
    "packages/ui"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:sdks && npm run build --workspace @identity/web && npm run build --workspace @identity/admin",
    "build:sdks": "node scripts/build-sdks.mjs",
    "test:advanced": "node --env-file=.env scripts/validate-compose.mjs scripts/advanced-integration.mjs",
    "test:trust": "node --env-file=.env scripts/validate-compose.mjs scripts/trust-integration.mjs",
    "test:operations": "node --env-file=.env scripts/validate-operations.mjs",
    "test:tls": "node --env-file=.env scripts/tls-rehearsal.mjs",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && npm run typecheck --workspace @identity/web && npm run typecheck --workspace @identity/admin && npm run typecheck --workspace @orbit-identity/sdk && tsc --noEmit -p packages/ui/tsconfig.json",
    "test": "vitest run",
    "test:integration": "node --env-file=.env scripts/validate-compose.mjs",
    "test:e2e": "playwright test",
    "lint": "eslint apps packages tests scripts integrations/cli",
    "format": "prettier --write apps packages tests scripts docs *.json *.yml",
    "format:check": "prettier --check apps packages tests scripts docs *.json *.yml",
    "migrate": "node --env-file=.env dist/packages/core/src/migrate.js",
    "dev:api": "node --env-file=.env dist/apps/api/src/main.js",
    "dev:web": "npm run dev --workspace @identity/web",
    "start:api": "node dist/apps/api/src/main.js",
    "start:delivery": "node dist/apps/delivery/src/main.js",
    "start:worker": "node dist/apps/worker/src/main.js",
    "start:scheduler": "node dist/apps/scheduler/src/main.js",
    "test:authorization": "node --env-file=.env scripts/validate-compose.mjs scripts/authorization-matrix.mjs",
    "test:restore": "node --env-file=.env scripts/backup-restore-test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1145.0",
    "@aws-sdk/s3-request-presigner": "3.1145.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "fast-xml-parser": "5.11.2",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "lucide-react": "1.52.0",
    "next": "16.3.8",
    "nodemailer": "10.0.13",
    "otpauth": "9.5.2",
    "parse5": "8.0.1",
    "pg": "8.23.1",
    "prom-client": "15.1.3",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.6.4",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
