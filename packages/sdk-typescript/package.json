{
  "name": "@orbit-identity/sdk",
  "version": "1.0.0",
  "description": "Typed policy-aware Orbit Identity REST client for JavaScript and TypeScript.",
  "type": "module",
  "license": "GPL-2.0-only",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json"
  }
}
